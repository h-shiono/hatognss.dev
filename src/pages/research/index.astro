---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import SectionLabel from '../../components/layout/SectionLabel.astro';
import { isJapanese } from '../../lib/utils';

const publications = await getCollection('publications');
const talks = await getCollection('talks');

const yearOf = (d: Date) => d.getUTCFullYear();
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short' });

type Year = number;
const years = Array.from(
  new Set([
    ...publications.map((p) => yearOf(p.data.date)),
    ...talks.map((t) => yearOf(t.data.date)),
  ]),
).sort((a, b) => b - a);

const byYear: Record<
  Year,
  { publications: typeof publications; talks: typeof talks }
> = {};
for (const y of years) byYear[y] = { publications: [], talks: [] };
for (const p of publications) byYear[yearOf(p.data.date)].publications.push(p);
for (const t of talks) byYear[yearOf(t.data.date)].talks.push(t);
for (const y of years) {
  byYear[y].publications.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  byYear[y].talks.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
}
---
<BaseLayout title="Research" description="Publications and talks.">
  <PageHeader
    title="Research"
    description="Peer-reviewed publications and conference talks on GNSS positioning."
  />

  {years.map((year) => (
    <section class="year">
      <h2 class="year-heading"><span class="year-num">{year}</span></h2>

      {byYear[year].publications.length > 0 && (
        <div class="group">
          <SectionLabel as="h3" en="Publications" ja="論文・著書" />
          <ul class="entry-list">
            {byYear[year].publications.map((p) => (
              <li class="entry">
                <a href={`/research/publications/${p.slug}/`} class="entry-row">
                  <span class="entry-date">{monthFmt.format(p.data.date)}</span>
                  <span class="entry-body">
                    <span
                      class="entry-title"
                      lang={isJapanese(p.data.title) ? 'ja' : undefined}
                    >{p.data.title}</span>
                    <span class="entry-meta">
                      <span>{p.data.authors.join(', ')}</span>
                      <span class="dot" aria-hidden="true">·</span>
                      <em
                        class="entry-venue"
                        lang={isJapanese(p.data.venue) ? 'ja' : undefined}
                      >{p.data.venue}</em>
                      {p.data.pages && (
                        <>
                          <span class="dot" aria-hidden="true">·</span>
                          <span class="entry-pages">{p.data.pages}</span>
                        </>
                      )}
                    </span>
                    <span class="entry-chips">
                      <span class="entry-kind">{p.data.type}</span>
                      {p.data.awards?.map((a) => (
                        <span class="entry-award">{a.name}</span>
                      ))}
                    </span>
                  </span>
                  <span class="entry-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {byYear[year].talks.length > 0 && (
        <div class="group">
          <SectionLabel as="h3" en="Talks" ja="講演" />
          <ul class="entry-list">
            {byYear[year].talks.map((t) => (
              <li class="entry">
                <a href={`/research/talks/${t.slug}/`} class="entry-row">
                  <span class="entry-date">{monthFmt.format(t.data.date)}</span>
                  <span class="entry-body">
                    <span
                      class="entry-title"
                      lang={isJapanese(t.data.title) ? 'ja' : undefined}
                    >{t.data.title}</span>
                    <span class="entry-meta">
                      <span lang={isJapanese(t.data.event) ? 'ja' : undefined}>{t.data.event}</span>
                      {t.data.location && (
                        <>
                          <span class="dot" aria-hidden="true">·</span>
                          <span>{t.data.location}</span>
                        </>
                      )}
                    </span>
                    <span class="entry-chips">
                      <span class="entry-kind">{t.data.type}</span>
                      {t.data.awards?.map((a) => (
                        <span class="entry-award">{a.name}</span>
                      ))}
                    </span>
                  </span>
                  <span class="entry-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  ))}
</BaseLayout>

<style>
  .year {
    margin: 3rem 0;
  }
  /* The year is the spine of this page, so it carries a rule to its right. */
  .year-heading {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 1.75rem 0;
  }
  .year-num {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.10em;
    color: var(--color-text-primary);
  }
  .year-heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .group {
    margin-bottom: 2.5rem;
  }
  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    border-bottom: 1px solid var(--color-rule);
  }
  /* minmax(0,1fr) is required: without it a long English title widens the grid. */
  .entry-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    padding: 16px 8px 16px 0;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease-out, padding-left 0.15s ease-out;
  }
  .entry-row:hover {
    background: var(--color-row-hover);
    padding-left: 10px;
    text-decoration: none;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }
  .entry-title {
    font-size: 16.5px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-text-heading);
    text-wrap: pretty;
  }
  .entry-title[lang='ja'] {
    line-height: 1.6;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .entry-venue {
    font-family: var(--font-display);
    font-size: 14.5px;
    font-style: italic;
  }
  .entry-venue[lang='ja'] {
    font-family: inherit;
    font-size: inherit;
  }
  .entry-pages {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .dot {
    margin: 0 7px;
    color: var(--color-text-tertiary);
  }

  /* Kind and award sit on their own line so a wrapped title cannot orphan them. */
  .entry-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 2px;
  }
  .entry-kind,
  .entry-award {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 3px;
    padding: 3px 8px;
    line-height: 1.4;
  }
  .entry-kind {
    color: var(--color-accent);
    border: 1px solid var(--color-border);
  }
  .entry-award {
    color: var(--color-bg);
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
  }

  .entry-arrow {
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 640px) {
    .entry-row {
      grid-template-columns: 52px minmax(0, 1fr) auto;
      gap: 12px;
    }
  }
</style>
