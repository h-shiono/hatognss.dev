---
import { getCollection } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import SectionLabel from '../components/layout/SectionLabel.astro';

const hobbies = (await getCollection('projects', (e) => e.data.category === 'hobby'))
  .sort(
    (a, b) =>
      (b.data.updatedDate ?? b.data.startDate).getTime() -
      (a.data.updatedDate ?? a.data.startDate).getTime(),
  );

type RecognitionItem = {
  year: number;
  name: string;
  venue?: string;
  workTitle: string;
  workHref: string;
  url?: string;
};

const publications = await getCollection('publications');
const talks = await getCollection('talks');

const recognition: RecognitionItem[] = [];
for (const p of publications) {
  for (const a of p.data.awards ?? []) {
    recognition.push({
      year: a.year,
      name: a.name,
      venue: a.venue,
      workTitle: p.data.title,
      workHref: `/research/publications/${p.slug}/`,
      url: a.url,
    });
  }
}
for (const t of talks) {
  for (const a of t.data.awards ?? []) {
    recognition.push({
      year: a.year,
      name: a.name,
      venue: a.venue,
      workTitle: t.data.title,
      workHref: `/research/talks/${t.slug}/`,
      url: a.url,
    });
  }
}

const recognitionYears = Array.from(new Set(recognition.map((r) => r.year))).sort(
  (a, b) => b - a,
);
const recognitionByYear: Record<number, RecognitionItem[]> = {};
for (const y of recognitionYears) recognitionByYear[y] = [];
for (const r of recognition) recognitionByYear[r.year].push(r);
---
<ArticleLayout title="About" description="About hato.GNSS — GNSS researcher and OSS maintainer.">
  <h1>About</h1>
  <p>
    <strong>hato.GNSS</strong> is a GNSS researcher and open-source maintainer.
  </p>
  <p>
    The work collected here sits at the intersection of high-accuracy
    positioning, open-source tooling, and a quiet record of where talks have
    been given. Papers and conference talks live under
    <a href="/research/">Research</a>. Libraries and tools live under
    <a href="/oss/">OSS</a>. The geography of talks is plotted on
    <a href="/atlas/">Atlas</a>. Shorter notes are on the
    <a href="/blog/">blog</a>.
  </p>
  <p>
    Bio copy to be expanded.
  </p>

  {recognitionYears.length > 0 && (
    <section class="recognition" aria-labelledby="recognition-heading">
      <SectionLabel as="h2" id="recognition-heading" en="Awards" ja="受賞" />
      <ul class="year-list">
        {recognitionYears.map((y) => (
          <li class="year-row">
            <span class="year-num">{y}</span>
            <ul class="award-list">
              {recognitionByYear[y].map((r) => (
                <li class="award-row">
                  <span class="award-name">{r.name}{r.venue && <>, {r.venue}</>}</span>
                  <span class="award-meta">
                    <a class="award-work" href={r.workHref}>{r.workTitle}</a>
                    {r.url && (
                      <a class="award-ext" href={r.url} rel="noopener" target="_blank">Announcement →</a>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  )}

  {hobbies.length > 0 && (
    <section class="side-projects" aria-labelledby="side-projects-heading">
      <SectionLabel as="h2" id="side-projects-heading" en="Side projects" ja="寄り道" />
      <ul class="project-list">
        {hobbies.map((p) => (
          <li class="project">
            <h3 class="project-title">{p.data.title}</h3>
            <p class="project-summary">{p.data.summary}</p>
            {(p.data.repo || p.data.demo || p.data.docs) && (
              <ul class="project-links">
                {p.data.repo && <li><a href={p.data.repo} rel="noopener" target="_blank">Repo →</a></li>}
                {p.data.demo && <li><a href={p.data.demo} rel="noopener" target="_blank">Site →</a></li>}
                {p.data.docs && <li><a href={p.data.docs} rel="noopener" target="_blank">Docs →</a></li>}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}
</ArticleLayout>

<style>
  .side-projects {
    margin-top: 3rem;
  }
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .project {
    margin: 0;
  }
  .project-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-heading);
    margin: 0 0 0.25rem 0;
  }
  .project-summary {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0 0 0.5rem 0;
  }
  .project-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .project-links li {
    margin: 0;
  }
  .project-links a {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .project-links a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .recognition {
    margin-top: 3rem;
  }
  .year-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  /* Same three-part rhythm as a /research/ entry: date column, title, meta. */
  .year-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }
  .year-row .year-num {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }
  .award-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .award-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .award-name {
    font-size: 16.5px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-text-heading);
    text-wrap: pretty;
  }
  .award-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .award-work {
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s ease-out, border-color 0.15s ease-out;
  }
  .award-work:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    text-decoration: none;
  }
  .award-ext {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease-out;
  }
  .award-ext:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
</style>
