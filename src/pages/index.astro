---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/layout/SectionLabel.astro';

const sections = [
  {
    href: '/research/',
    eyebrow: 'Research',
    title: 'Publications & talks',
    desc: 'GNSS positioning research — papers and conference talks.',
  },
  {
    href: '/oss/',
    eyebrow: 'OSS',
    title: 'Open source',
    desc: 'Libraries and tools maintained as personal open-source work.',
  },
  {
    href: '/atlas/',
    eyebrow: 'Atlas',
    title: 'Atlas of talks',
    desc: 'A geographic record of where talks have been given.',
  },
  {
    href: '/blog/',
    eyebrow: 'Blog',
    title: 'Notes',
    desc: 'Short essays on positioning, tooling, and travel.',
  },
];
---
<BaseLayout description="GNSS · RESEARCH, ENGINEERING, AND OPEN SOURCE.">
  <section class="hero">
    <p class="hero-role">GNSS · RESEARCH, ENGINEERING, AND OPEN SOURCE</p>
    <h1 class="hero-tagline" lang="ja">
      衛星測位を鳥瞰する
    </h1>
    <p class="hero-tagline-en" lang="en">
      <em>Surveying, thinking, building — across satellite positioning / PNT</em>
    </p>
  </section>

  <section class="sections-toc">
    <SectionLabel as="h2" en="Sections" ja="章立て" />
    <div class="toc-grid">
      {sections.map((s) => (
        <a href={s.href} class="toc-card">
          <span class="toc-eyebrow">{s.eyebrow}</span>
          <span class="toc-title">{s.title}</span>
          <span class="toc-desc">{s.desc}</span>
          <span class="toc-cta">Browse <span class="toc-cta-arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    margin: 2.25rem 0 3.25rem 0;
  }
  .hero-role {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.125rem 0;
  }
  /*
   * The one heading kept in serif on purpose: --font-display-serif has no
   * Noto Sans JP fallback, so the JA tagline stays mincho.
   */
  .hero-tagline {
    font-family: var(--font-display-serif);
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.005em;
    margin: 0 0 0.875rem 0;
    color: var(--color-text-heading);
    text-wrap: pretty;
  }
  .hero-tagline-en {
    font-family: var(--font-display-serif);
    font-size: 18px;
    font-weight: 400;
    font-style: italic;
    line-height: 1.55;
    margin: 0;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .sections-toc {
    margin: 3.25rem 0;
  }
  .toc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  .toc-card {
    display: grid;
    gap: 9px;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    color: inherit;
    text-decoration: none;
    background: var(--color-surface);
    transition: border-color 0.15s ease-out, background-color 0.15s ease-out;
  }
  .toc-card:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-hover);
    text-decoration: none;
  }
  .toc-eyebrow {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .toc-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-heading);
  }
  .toc-desc {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .toc-cta {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.10em;
    color: var(--color-accent);
  }
  .toc-cta-arrow {
    font-size: 14px;
  }
</style>
