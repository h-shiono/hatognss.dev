---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';

const posts = (await getCollection('blog', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const yearOf = (d: Date) => d.getUTCFullYear();
const monthDayFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: '2-digit',
});

const years = Array.from(new Set(posts.map((p) => yearOf(p.data.date)))).sort(
  (a, b) => b - a,
);
---
<BaseLayout title="Blog" description="Notes and short essays.">
  <PageHeader
    title="Blog"
    description="Notes on positioning, tooling, and travel."
  />

  {years.map((year) => (
    <section class="year">
      <h2 class="year-heading"><span class="year-num">{year}</span></h2>
      <ul class="post-list">
        {posts.filter((p) => yearOf(p.data.date) === year).map((p) => (
          <li class="post">
            <a href={`/blog/${p.slug}/`} class="post-row" lang={p.data.language}>
              <span class="post-date">{monthDayFmt.format(p.data.date)}</span>
              <span class="post-body">
                <span class="post-title">{p.data.title}</span>
                <span class="post-desc">{p.data.description}</span>
              </span>
              <span class="post-lang">{p.data.language.toUpperCase()}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .year {
    margin: 3rem 0;
  }
  .year-heading {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 1.75rem 0;
  }
  .year-num {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.10em;
    color: var(--color-text-primary);
  }
  .year-heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post {
    border-bottom: 1px solid var(--color-rule);
  }
  .post-row {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    padding: 14px 8px 14px 0;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease-out, padding-left 0.15s ease-out;
  }
  .post-row:hover {
    background: var(--color-row-hover);
    padding-left: 10px;
    text-decoration: none;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }
  .post-body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }
  .post-title {
    font-size: 16.5px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-text-heading);
    text-wrap: pretty;
  }
  .post-row[lang='ja'] .post-title {
    line-height: 1.6;
  }
  .post-desc {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .post-lang {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
    border-radius: 3px;
    padding: 2px 7px;
    line-height: 1.4;
  }
  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: 64px minmax(0, 1fr) auto;
      gap: 12px;
    }
  }
</style>
