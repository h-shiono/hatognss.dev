---
import type { CollectionEntry } from 'astro:content';

interface Props {
  talks: CollectionEntry<'talks'>[];
}

const { talks } = Astro.props;

const sorted = [...talks].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
});

function formatYearMonth(d: Date): string {
  return fmt.format(d);
}
---

<ul class="atlas-list">
  {sorted.map((t) => (
    <li class="atlas-list-row">
      <a
        href={`/research/talks/${t.slug}/`}
        data-atlas-id={t.slug}
        class="atlas-list-link"
      >
        <span class="atlas-list-date">{formatYearMonth(t.data.date)}</span>
        <span class="atlas-list-main">
          <span class="atlas-list-title">{t.data.title}</span>
          <span class="atlas-list-venue">{t.data.event}</span>
        </span>
        <span class="atlas-list-location">{t.data.location ?? '—'}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .atlas-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .atlas-list-row {
    border-bottom: 1px solid var(--color-rule);
  }

  .atlas-list-link {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: baseline;
    padding: 14px 12px;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease-out;
  }

  /* Row hover uses its own surface, distinct from the map's land fill. */
  .atlas-list-link:hover,
  .atlas-list-link[data-atlas-hovered] {
    background-color: var(--color-row-hover);
    text-decoration: none;
  }

  .atlas-list-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  .atlas-list-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .atlas-list-title {
    font-size: 15.5px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-text-heading);
    text-wrap: pretty;
  }

  .atlas-list-venue {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .atlas-list-location {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .atlas-list-link {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .atlas-list-location {
      text-align: left;
    }
  }
</style>
