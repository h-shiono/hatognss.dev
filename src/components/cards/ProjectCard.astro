---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, summary, status, tech, repo, website, demo, docs, doi, category } =
  entry.data;

const sectionRoot =
  category === 'oss' ? 'oss' : category === 'work' ? 'works' : 'blog';
const detailHref = `/${sectionRoot}/${entry.slug}/`;
---
<article class="project-card">
  <header class="project-card-header">
    <h3 class="project-card-title"><a href={detailHref}>{title}</a></h3>
    <span class="project-card-status" data-status={status}>{status}</span>
  </header>
  <p class="project-card-summary">{summary}</p>
  {tech.length > 0 && (
    <ul class="project-card-tech" aria-label="Tech stack">
      {tech.map((t) => <li>{t}</li>)}
    </ul>
  )}
  <ul class="project-card-links" aria-label="Links">
    {repo && <li><a href={repo} rel="noopener" target="_blank">Repo <span aria-hidden="true">↗</span></a></li>}
    {website && <li><a href={website} rel="noopener" target="_blank">Website <span aria-hidden="true">↗</span></a></li>}
    {demo && <li><a href={demo} rel="noopener" target="_blank">Demo <span aria-hidden="true">↗</span></a></li>}
    {docs && <li><a href={docs} rel="noopener" target="_blank">Docs <span aria-hidden="true">↗</span></a></li>}
    {doi && <li><a href={`https://doi.org/${doi}`} rel="noopener" target="_blank">DOI <span aria-hidden="true">↗</span></a></li>}
  </ul>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    background: var(--color-surface);
    transition: border-color 0.15s ease-out, background-color 0.15s ease-out;
  }
  .project-card:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-hover);
  }

  .project-card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .project-card-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
    color: var(--color-text-heading);
  }
  .project-card-title a {
    color: inherit;
    text-decoration: none;
  }
  .project-card-title a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .project-card-status {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 3px 7px;
    line-height: 1.4;
    white-space: nowrap;
  }
  .project-card-status[data-status='active'] {
    color: var(--color-accent);
    border-color: var(--color-accent-border);
  }
  .project-card-status[data-status='archived'] {
    color: var(--color-text-tertiary);
  }

  .project-card-summary {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Tech: filled, borderless — reads as a label, not a control. */
  .project-card-tech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .project-card-tech li {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--color-chip-fg);
    background: var(--color-background-secondary);
    border-radius: 3px;
    padding: 3px 8px;
    line-height: 1.5;
  }

  /* Links: outlined buttons — reads as a control. margin-top keeps the row
     pinned to the bottom of the card whatever the summary length. */
  .project-card-links {
    list-style: none;
    margin: auto 0 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .project-card-links a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 5px 11px;
    line-height: 1.4;
    text-decoration: none;
    transition: background-color 0.15s ease-out, border-color 0.15s ease-out;
  }
  .project-card-links a:hover {
    background: var(--color-chip-hover-bg);
    border-color: var(--color-accent-border);
    text-decoration: none;
  }
</style>
